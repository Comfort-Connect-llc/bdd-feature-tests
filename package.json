{
  "name": "comfort-connect-bdd-tests",
  "version": "1.0.0",
  "description": "BDD test suite for Comfort Connect POS Origination Platform",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:parallel": "cucumber-js --parallel 4",
    "test:domain": "cucumber-js features/domain-$DOMAIN-*/**/*.feature",
    "test:tags": "cucumber-js --tags",
    "test:smoke": "cucumber-js --tags '@smoke'",
    "test:report": "cucumber-js --format html:reports/cucumber-report.html",
    "test:debug": "cucumber-js --fail-fast",
    "playwright:install": "playwright install"
  },
  "keywords": [
    "bdd",
    "cucumber",
    "playwright",
    "testing",
    "comfort-connect"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
